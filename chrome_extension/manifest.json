{
  "manifest_version": 3,
  "name": "PDF AI Assistant",
  "version": "1.0",
  "permissions": [
    "activeTab"
  ],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://your-domain-name.com/*"       
  ],
  "content_scripts": [
    {
      "matches": ["*://*/*.pdf", "*://*/*.pdf?*"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ]
}